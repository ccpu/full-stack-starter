{
  "extends": [
    "@internal/tsconfig/base.json",
    "@internal/tsconfig/nativewind.json"
  ],
  "compilerOptions": {
    "jsx": "react-native",
    "baseUrl": ".",
    "moduleSuffixes": [
      ".ios",
      ".android",
      ".native",
      ""
    ],
    "checkJs": false
  },
  "include": [
    "src",
    "*.ts",
    "*.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "metro.config.js",
    "tailwind.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}