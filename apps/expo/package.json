{
  "name": "@internal/expo",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@internal/app": "workspace:*",
    "expo": "catalog:expo",
    "expo-constants": "catalog:expo",
    "expo-linking": "catalog:expo",
    "expo-router": "catalog:expo",
    "expo-status-bar": "catalog:expo",
    "nativewind": "catalog:prod",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "react-native": "catalog:expo",
    "react-native-css-interop": "catalog:prod",
    "react-native-reanimated": "catalog:expo",
    "react-native-safe-area-context": "catalog:expo",
    "react-native-screens": "catalog:expo",
    "react-native-worklets": "catalog:expo"
  },
  "devDependencies": {
    "@babel/core": "catalog:dev",
    "@babel/plugin-transform-react-jsx": "catalog:dev",
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tailwind-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/react": "catalog:dev",
    "babel-preset-expo": "catalog:expo",
    "eslint": "catalog:dev",
    "metro-cache": "catalog:expo",
    "prettier": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "prettier": "@internal/prettier-config",
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
  }
}
