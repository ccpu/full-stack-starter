{
  "extends": [
    "@acme/tsconfig/base.json",
    "@acme/tsconfig/nativewind.json"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src",
    "src/nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src/zip.js"
  ]
}