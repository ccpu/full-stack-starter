{
  "extends": ["@internal/tsconfig/base.json", "@internal/tsconfig/nativewind.json"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "nativewind",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "module": "esnext"
  },
  "include": [".", ".next/types/**/*.ts", "eslint.config.ts", "tailwind.config.ts"],
  "exclude": ["node_modules"]
}
