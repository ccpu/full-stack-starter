{
  "name": "@internal/nextjs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev --turbopack",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@expo/next-adapter": "6.0.0",
    "@internal/app": "workspace:*",
    "@internal/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.8",
    "next": "15.3.3",
    "next-themes": "^0.4.6",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tailwind-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^10.0.0",
    "jiti": "^2.6.0",
    "prettier": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
