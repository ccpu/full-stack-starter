{
  "name": "full-stack-starter",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=9.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "native": "cd apps/expo && pnpm dev",
    "expo:clean:install": "cd apps/expo && pnpm clean && cd ../.. && pnpm install",
    "expo:clean:run": "pnpm expo:clean:install && pnpm run native",
    "android:dev": "cd apps/expo && pnpm dev:android",
    "android:clean:dev": "pnpm expo:clean:install && pnpm android:dev",
    "ios:dev": "cd apps/expo && pnpm dev:ios",
    "ios:clean:dev": "pnpm expo:clean:install && pnpm ios:dev",
    "web": "cd apps/next && pnpm next",
    "web:clean:install": "cd apps/next && pnpm clean && cd ../.. && pnpm install",
    "web:clean:dev": "pnpm web:clean:install && pnpm run web",
    "extension:clean:dev": "cd apps/extension && pnpm clean:install && pnpm dev",
    "generate:api-client": "cd scripts && tsx generate-api-client.ts && pnpm install",
    "generate:api-client:force": "cd scripts && tsx generate-api-client.ts --force && pnpm install",
    "tsc:watch": "pnpm exec tsc --noEmit --watch --project tsconfig.watch.json",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "pnpm format --write",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache && pnpm lint:root",
    "lint:fix": "pnpm lint --fix && pnpm lint:root:fix",
    "lint:root": "eslint .github *.config.{js,cjs,mjs,ts} *.json README.md --cache --cache-location .cache/.eslintcache",
    "lint:root:fix": "pnpm lint:root --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "fix:all": "pnpm format:fix && pnpm lint:fix",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean:packages": "node scripts/cleanup-node-modules.js",
    "clean:packages:install": "pnpm clean:packages && pnpm install",
    "clean:workspaces": "turbo run clean:all && git clean -xdf .cache .turbo",
    "clean:workspaces:install": "pnpm clean:workspaces && pnpm install",
    "deps:update": "npx taze -r -w && pnpm install",
    "deps:update:major": "npx taze major -r -w && pnpm install",
    "turbo:gen:init": "pnpm turbo gen init",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "catalog:dev",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@internal/prettier-config": "workspace:*",
    "@pixpilot/workspace-package-generator": "^1.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "catalog:dev",
    "tsx": "^4.20.4",
    "turbo": "^2.5.6",
    "typescript": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
