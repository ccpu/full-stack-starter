{
  "extends": "@internal/tsconfig/base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "index.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
